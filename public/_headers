# Netlify / Cloudflare Pages headers. Lets the Vatar game player (Lagos Life and partner worlds) frame
# the game, as required by https://lagoslife.app/developers/docs. Do NOT add X-Frame-Options.
/*
  Content-Security-Policy: frame-ancestors https://lagoslife.app https://www.lagoslife.app https://naijalife.app https://www.naijalife.app https://lagoslife.eliysites.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
